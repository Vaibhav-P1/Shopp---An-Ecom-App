rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // True if the signed-in user holds the "seller" role on their profile.
    function isSeller() {
      return signedIn()
        && 'seller' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []);
    }

    // The profile may only gain the seller role together with a `sellers/{uid}` document written in the same
    // batch; otherwise the roles stay exactly as they were.
    function rolesUnchangedOrSellerOnboarding(uid) {
      let before = resource == null ? ['customer'] : resource.data.get('roles', ['customer']);
      let after = request.resource.data.get('roles', ['customer']);
      return after == before
        || (after.hasOnly(['customer', 'seller']) && 'seller' in after
            && existsAfter(/databases/$(database)/documents/sellers/$(uid)));
    }

    // Each user can read and write only their own profile, cart and address.
    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && rolesUnchangedOrSellerOnboarding(uid);

      // Saved delivery addresses: owner only, with a fixed shape so malformed documents are rejected.
      match /addresses/{addressId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['label', 'recipient', 'phone', 'street', 'city', 'pincode', 'primary'])
          && request.resource.data.keys().hasAll(['label', 'recipient', 'phone', 'street', 'city', 'pincode', 'primary'])
          && request.resource.data.label is string && request.resource.data.label.size() > 0
          && request.resource.data.recipient is string && request.resource.data.recipient.size() > 0
          && request.resource.data.phone is string && request.resource.data.phone.matches('[6-9][0-9]{9}')
          && request.resource.data.street is string && request.resource.data.street.size() >= 5
          && request.resource.data.city is string && request.resource.data.city.size() > 0
          && request.resource.data.pincode is string && request.resource.data.pincode.matches('[1-9][0-9]{5}')
          && request.resource.data.primary is bool;
      }
    }

    // Seller profiles: owner only. Anyone signed in may create their own (self-service onboarding).
    match /sellers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['shopName', 'phone', 'status', 'createdAt'])
        && request.resource.data.shopName is string && request.resource.data.shopName.size() >= 2
        && request.resource.data.shopName.size() <= 40
        && request.resource.data.phone is string && request.resource.data.phone.matches('[6-9][0-9]{9}')
        && request.resource.data.status == 'approved';
      allow delete: if false;
    }

    // Catalogue (products, categories, banners) is read-only for signed-in users.
    match /data/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Seller-listed products. Sellers create, edit and delete only their own (`sellerId == uid`), and a
    // product must keep a fixed shape. Any signed-in user may lower a product's stock, nothing else: that is
    // how an order reserves units inside its transaction.
    match /data/stock/products/{productId} {
      function validProduct() {
        let data = request.resource.data;
        return data.keys().hasOnly(['sellerId', 'title', 'description', 'category', 'price', 'actualPrice', 'images', 'stock', 'active', 'otherDetails'])
          && data.keys().hasAll(['sellerId', 'title', 'category', 'price', 'actualPrice', 'images', 'stock', 'active'])
          && data.title is string && data.title.size() >= 3 && data.title.size() <= 80
          && data.get('description', '') is string && data.get('description', '').size() <= 1000
          && data.category is string && data.category.size() > 0
          && data.price is string && data.price.matches('[0-9]+(\\.[0-9]{1,2})?')
          && data.actualPrice is string && data.actualPrice.matches('[0-9]+(\\.[0-9]{1,2})?')
          && data.images is list && data.images.size() >= 1 && data.images.size() <= 6
          && data.stock is int && data.stock >= 0
          && data.active is bool;
      }

      allow create: if isSeller() && request.resource.data.sellerId == request.auth.uid && validProduct();
      allow update: if isSeller() && resource.data.get('sellerId', '') == request.auth.uid
        && request.resource.data.sellerId == request.auth.uid && validProduct();
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && resource.data.stock is int && request.resource.data.stock is int
        && request.resource.data.stock >= 0 && request.resource.data.stock < resource.data.stock;
      allow delete: if isSeller() && resource.data.get('sellerId', '') == request.auth.uid;
    }

    // Reviews: one per user per product (the document id is the author's uid), and only for buyers. The
    // review must point at one of the author's own delivered orders that contains the product.
    match /data/stock/products/{productId}/reviews/{uid} {
      function ownDeliveredOrder() {
        let order = get(/databases/$(database)/documents/orders/$(request.resource.data.orderId));
        return order.data.userId == request.auth.uid
          && order.data.status == 'DELIVERED'
          && productId in order.data.items.keys();
      }

      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['userId', 'userName', 'orderId', 'rating', 'text', 'updatedAt'])
        && request.resource.data.userId == uid
        && request.resource.data.userName is string && request.resource.data.userName.size() <= 80
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && request.resource.data.updatedAt == request.time
        && ownDeliveredOrder();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Coupons are managed in the console; the app can only read them (orders re-check them in a transaction).
    match /coupons/{code} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /offers/{offerId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Orders: owners create and read their own orders; the only edit allowed is cancelling a fresh one.
    // `resource == null` lets order placement check whether an order id already exists (idempotency).
    match /orders/{orderId} {
      allow read: if signedIn() && (resource == null || resource.data.userId == request.auth.uid
        || request.auth.uid in resource.data.get('sellerIds', []));
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      // A seller named on the order moves it one step forward: ORDERED -> PACKED -> SHIPPED -> DELIVERED
      allow update: if signedIn() && request.auth.uid in resource.data.get('sellerIds', [])
        && ((resource.data.status == 'ORDERED' && request.resource.data.status == 'PACKED')
          || (resource.data.status == 'PACKED' && request.resource.data.status == 'SHIPPED')
          || (resource.data.status == 'SHIPPED' && request.resource.data.status == 'DELIVERED'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusUpdatedAt']);
      // The only client-side change is cancelling an order that has not been packed yet
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && resource.data.status == 'ORDERED'
        && request.resource.data.status == 'CANCELLED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']);
      allow delete: if false;
    }
  }
}
